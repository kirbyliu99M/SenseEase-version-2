# OpenVINO IR weights — large binary files tracked via Git LFS.
# `git lfs install` must be run once per machine before clone/pull.
# Use ** so per-precision subfolders (FP16/, FP32/) and per-model subfolders
# (face-detection-adas-0001/FP16/, head-pose-estimation-adas-0001/FP32/) are
# all routed through LFS.
models/**/*.bin filter=lfs diff=lfs merge=lfs -text
models/**/*.xml filter=lfs diff=lfs merge=lfs -text
models/*.bin filter=lfs diff=lfs merge=lfs -text
models/*.xml filter=lfs diff=lfs merge=lfs -text
